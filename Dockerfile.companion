FROM node:22-slim AS frontend

WORKDIR /build
COPY companion/frontend/package.json companion/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY companion/frontend/ ./
RUN npm run build

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY companion/backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY companion/backend/hive_companion/ ./hive_companion/
COPY --from=frontend /build/dist/ /app/frontend/dist/

RUN useradd -r -s /bin/false companion && mkdir -p /app/data/companion && chown -R companion:companion /app
USER companion

EXPOSE 8001
ENV COMPANION_HOST=0.0.0.0 COMPANION_PORT=8001 \
    HIVE_API_URL=http://localhost:7777 \
    COMPANION_DATA_DIR=/app/data/companion \
    COMPANION_FRONTEND_DIST=/app/frontend/dist

CMD ["python", "-m", "uvicorn", "hive_companion.main:app", "--host", "0.0.0.0", "--port", "8001"]
